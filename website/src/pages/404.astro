---
import { docLink } from "../doc-links.ts";
import Page from "../layouts/Page.astro";

const gettingStarted = await docLink("docs");
---

<Page title="Page not found | Kerpeten" description="This page does not exist.">
  <section class="hero wrap missing">
    <div class="hero-text">
      <h1>404: there is no page at this address.</h1>
      <div class="hero-actions">
        <a class="button" href="/">Go to the start page</a>
        <a class="plain" href={gettingStarted.href}>Read the docs</a>
      </div>
    </div>
  </section>
</Page>
