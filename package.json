{
  "name": "kerpeten-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.5",
  "bin": {
    "kerpeten": "scripts/kerpeten.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run typecheck && bun test && bun run no-comments && bun run blank-lines && bun run layout",
    "lint": "biome ci .",
    "format": "bun scripts/blank-lines.ts --write && biome check --write .",
    "typecheck": "tsc --noEmit",
    "no-comments": "bun scripts/no-comments.ts",
    "blank-lines": "bun scripts/blank-lines.ts",
    "layout": "bun scripts/layout.ts",
    "gen-types": "bunx openapi-typescript@7.13.0 openapi.json --root-types --root-types-no-schema-prefix -o src/api/types/api.generated.ts",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/openai": "4.0.122",
    "@asenajs/ioc": "0.2.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.179",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
